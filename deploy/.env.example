# Copy to ../.env (next to docker-compose.yml). Never commit it. No real secrets belong in this file.
# public host name whose DNS points at this machine, e.g. minutes.example.org
SMMG_DOMAIN=
# same project the Flutter app signs in with
FIREBASE_PROJECT_ID=
# at least 32 random characters:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
BOT_SHARED_SECRET=
# leave empty to use rule-based minutes only (set LLM_PROVIDER=rules then)
OPENAI_API_KEY=
# openai | rules
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# empty = auto-detect
WHISPER_LANGUAGE=
# the Jitsi server used when a meeting is created from a bare room name
DEFAULT_JITSI_SERVER=https://meet.jit.si
# empty = any public Jitsi host; e.g. meet.jit.si to restrict
JITSI_ALLOWED_HOSTS=
# memory reserved for raw audio while meetings are processed
TEMP_TMPFS_SIZE=2g
