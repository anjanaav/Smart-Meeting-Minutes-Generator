# Copy to .env (never commit .env). No real secrets belong in this file.
# development | production
APP_ENV=development
# firebase | dev  (dev = unverified tokens, refused when APP_ENV=production)
AUTH_MODE=firebase
# firestore | memory (memory = local testing only)
STORE_BACKEND=firestore

# --- Firebase (add these when you connect Firebase) ---
FIREBASE_PROJECT_ID=
# path to the service-account JSON ON THE SERVER; never ship it in the app
GOOGLE_APPLICATION_CREDENTIALS=

# --- Minutes generation (OpenAI) ---
# openai | rules (rules = no AI service, rule-based extraction only)
LLM_PROVIDER=openai
# paste your key here, in .env only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# long meetings are split into overlapping windows of this size
LLM_WINDOW_CHARS=24000

# --- Speech recognition ---
# tiny | base | small | medium | large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=base
# empty = auto-detect, or e.g. en
WHISPER_LANGUAGE=

# --- Bot server (Node.js) ---
BOT_SERVER_URL=http://localhost:3000
# extra allowed bot hosts, comma separated (host:port)
BOT_SERVER_ALLOWLIST=
# long random string; set the same value on the bot server
BOT_SHARED_SECRET=
# URL the bot uses to reach this backend (default: the request's own host)
PUBLIC_BACKEND_URL=
BOT_DISPLAY_NAME=Smart Meeting Minutes Bot

# --- Jitsi ---
DEFAULT_JITSI_SERVER=https://meet.jit.si
# empty = any public Jitsi host; set to restrict
JITSI_ALLOWED_HOSTS=

# --- Temporary data (raw audio is never kept permanently) ---
TEMP_DIR=tmp_audio
# failed jobs stay retryable this long, then are purged
TEMP_RETENTION_MINUTES=60
# a silent bot's meeting is finalized automatically after this
BOT_IDLE_TIMEOUT_MINUTES=10
# mean volume below this counts as silence
MIN_AUDIO_DB=-55
