# Copy to .env (never commit .env). The bot reads these from the environment.
BOT_HOST=127.0.0.1
BOT_PORT=3000
# Must equal BOT_SHARED_SECRET on the Flask backend (at least 32 characters).
BOT_SHARED_SECRET=
BOT_DISPLAY_NAME=Smart Meeting Minutes Bot
# playwright = real Jitsi rooms. fake = simulated meeting for tests only.
BOT_DRIVER=playwright
BOT_HEADLESS=true
# Only needed in some containers:
BOT_CHROMIUM_NO_SANDBOX=false
# Optional restrictions:
BOT_JITSI_ALLOWED_HOSTS=
BOT_BACKEND_ALLOWLIST=
BOT_ALLOW_HTTP_BACKEND=false
BOT_CHUNK_MS=10000
BOT_MAX_SESSIONS=2
